# PostgreSQL connection
DATABASE_URL="postgresql://eplus:CHANGE_ME@localhost:5432/eplus?schema=public"
# Generate with: openssl rand -hex 48   (must be >= 32 chars; the server refuses the dev value in production)
JWT_SECRET="dev-only-change-me-0123456789abcdef0123456789abcdef"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
PORT=4000
NODE_ENV=development
# Clinic timezone: all "today" calculations use it
TZ=Asia/Amman
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Only needed if the web app is served from a different origin
CORS_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (nginx) so client IPs are logged correctly
TRUST_PROXY=0
# First admin created by `npm run db:bootstrap` (random password printed if omitted)
ADMIN_USERNAME=admin
ADMIN_PASSWORD="Admin@12345"
