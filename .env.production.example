# EmergencyPlus settings for docker compose. start.bat / start.command create .env automatically;
# copy this file to .env only to set things up by hand. Keep .env private and do not lose it.

# Database password, used when the database is first created. Changing it later breaks the connection.
DB_PASSWORD=change-me-strong-password
# Leave empty to auto-generate (kept in the app data volume)
JWT_SECRET=
APP_PORT=4080
TZ=Asia/Amman

# Daily backups (database + attachments). Point BACKUP_DIR at an external disk or a synced cloud folder.
BACKUP_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30

# auto (default): Secure cookies + HSTS for HTTPS requests through the domain, plain cookies on the http IP.
SECURE_COOKIES=auto

# ── Optional: HTTPS through the clinic's own domain (run domain-setup.bat instead of editing by hand) ──
# COMPOSE_PROFILES=domain
# DOMAIN=eplus.life
# ACME_EMAIL=you@example.com
# Cloudflare API token with permission Zone → DNS → Edit for this domain only (used just for the certificate).
# DNS_API_TOKEN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_FORCE_CHANGE=true
DEMO_DATA=false
