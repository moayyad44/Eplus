# Optional settings for docker compose (copy to a file named .env next to docker-compose.yml)
DB_PASSWORD=change-me-strong-password
# Leave empty to auto-generate
JWT_SECRET=
APP_PORT=4080
TZ=Asia/Amman
# true only behind HTTPS (reverse proxy); also set TRUST_PROXY=1 then
SECURE_COOKIES=false
TRUST_PROXY=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_FORCE_CHANGE=true
DEMO_DATA=false
